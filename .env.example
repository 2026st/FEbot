# Slack（Socket Mode）
SLACK_TOKEN=
SLACK_APP_TOKEN=

# --- AI バックエンドの選び方 ---
# USE_BEDROCK=true、または BEDROCK_CHAT_MODEL_ID を設定するとチャットは Amazon Bedrock。
# 埋め込み（RAG 検索クエリ）は常に OpenAI 互換 API（AI_API_KEY・AI_EMBEDDING_MODEL 等）。
# Bedrock 利用時も AI_API_KEY が必須（埋め込み用）。USE_BEDROCK=false でチャットも OpenAI 互換のみに固定。
# USE_BEDROCK=

# --- Amazon Bedrock（例: 東京・チャットのみ）---
# AWS_REGION=ap-northeast-1
# AWS_DEFAULT_REGION=ap-northeast-1
# 未設定かつ USE_BEDROCK=true のとき既定: anthropic.claude-3-5-haiku-20241022-v1:0（in-region 向け）
# BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# 東京で Sonnet 4.6 を geo 推論で使う例（AWS モデルカードの inference profile ID）。
# 注意: jp.* プロファイルは IAM に aws-marketplace:ViewSubscriptions / Subscribe が無いと
# AccessDenied になることがある。回避は in-region モデル（上の Haiku 等）か Marketplace 権限付与。
# 詳細: docs/20260514-bedrock-marketplace-access.md
# BEDROCK_CHAT_MODEL_ID=jp.anthropic.claude-sonnet-4-6
# Converse を使わず最初から InvokeModel のみ（Converse 権限が無い環境向け）
# BEDROCK_CHAT_SKIP_CONVERSE=false
# （参考・現状の埋め込みは Bedrock では使わない）Titan 用の旧変数:
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- OpenAI 互換 API（埋め込みは Bedrock 時も必須。Bedrock 未使用時はチャットもこちら）---
# IPA 過去問 ingest の LLM 補正も常にこちら（USE_BEDROCK の有無に関わらない）
# AI_API_KEY=
# 省略時は OpenAI 公式。Azure 等はベース URL を指定
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# 任意（デフォルトは下記コメント相当）
# CHROMA_PATH=./data/chroma
# CORPUS_DIR=./data/corpus
# 練習問題（/fe-quiz）の読み込み先。RAG 用 corpus とは別
# QUIZ_DIR=./data/quiz
# RAG_TOP_K=5
# ベクトル検索のコサイン距離上限（小さいほど厳しい）。無効化: RAG_MAX_DISTANCE=off
# RAG_MAX_DISTANCE=0.52
# 検索プール倍率（大きいほど距離フィルタ前に多く読む）
# RAG_POOL_MULT=5
# Slack ユーザーごとの1分あたりRAG呼び出し上限
# RATE_LIMIT_PER_MINUTE=20

# Web 検索フォールバック（DuckDuckGo、APIキー不要）
# WEB_SEARCH_MAX_RESULTS=5

# コンテンツフィルター（LLMで質問がIT・プログラミング関連かを判定）
# CONTENT_FILTER_ENABLED=true

# スレッド会話履歴（インメモリ。ボット再起動で消える）
# THREAD_HISTORY_MAX_TURNS=10
# THREAD_MAX_SESSIONS=500

SUPABASE_URL=
SUPABASE_KEY=
# ingest CLI 用（scripts/ipa_ingest_quiz.py）。ボットは SUPABASE_KEY（anon）で読取のみ
# SUPABASE_SERVICE_KEY=
