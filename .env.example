# Slack（Socket Mode）
SLACK_TOKEN=
SLACK_APP_TOKEN=

# --- AI バックエンドの選び方 ---
# 「BEDROCK_CHAT_MODEL_ID」「BEDROCK_EMBEDDING_MODEL_ID」の両方を環境に設定すると Bedrock を使用。
# 両方とも未設定（または USE_BEDROCK=false）なら OpenAI 互換 API（AI_API_KEY）を使用。
# USE_BEDROCK=true で明示的に Bedrock を選べます（モデル ID は下記デフォルトで補完可）。
# USE_BEDROCK=false で Bedrock のキーが残っていても OpenAI 側を強制できます。
# USE_BEDROCK=

# --- Amazon Bedrock（例: 東京）---
# AWS_REGION=ap-northeast-1
# AWS_DEFAULT_REGION=ap-northeast-1
# BEDROCK_CHAT_MODEL_ID=anthropic.claude-sonnet-4-6
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan Text Embeddings V2 の出力次元（1024 / 512 / 256）
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- OpenAI 互換 API（Bedrock の2モデル ID が無いとき）---
# AI_API_KEY=
# 省略時は OpenAI 公式。Azure 等はベース URL を指定
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# 任意（デフォルトは下記コメント相当）
# CHROMA_PATH=./data/chroma
# CORPUS_DIR=./data/corpus
# RAG_TOP_K=5
# ベクトル検索のコサイン距離上限（小さいほど厳しい）。無関係な ipa チャンクを減らす。無効化: RAG_MAX_DISTANCE=off
# RAG_MAX_DISTANCE=0.52
# 検索プール倍率（大きいほど距離フィルタ前に多く読む）
# RAG_POOL_MULT=5
# Slack ユーザーごとの1分あたりRAG呼び出し上限
# RATE_LIMIT_PER_MINUTE=20

# Web 検索フォールバック（DuckDuckGo、APIキー不要）
# WEB_SEARCH_MAX_RESULTS=5

# コンテンツフィルター（LLMで質問がIT・プログラミング関連かを判定）
# CONTENT_FILTER_ENABLED=true

SUPABASE_URL=
SUPABASE_KEY=
